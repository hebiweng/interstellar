{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interstellar.dev/schemas/v1/common.schema.json",
  "title": "Interstellar Common Types",
  "$defs": {
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "SemVer": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "ContentHash": {
      "type": "string",
      "pattern": "^(?:sha256|hmac-sha256):[A-Fa-f0-9]{32,128}$"
    },
    "Maturity": {
      "type": "string",
      "enum": ["stable", "beta", "experimental"]
    },
    "SubjectKind": {
      "type": "string",
      "enum": ["person", "event", "project", "organization", "country", "relationship", "question", "location"]
    },
    "ChartFamily": {
      "type": "string",
      "enum": ["natal", "transit", "progression", "direction", "return", "relationship", "horary", "electional", "relocation", "mundane", "harmonic", "custom"]
    },
    "EvidencePolarity": {
      "type": "string",
      "enum": ["support", "pressure", "neutral", "counter"]
    },
    "JobStatus": {
      "type": "string",
      "enum": ["queued", "running", "succeeded", "partial", "failed", "cancelling", "cancelled", "timed_out", "expired"]
    },
    "ResourceStatus": {
      "type": "string",
      "enum": ["generated", "degraded", "blocked", "not_requested"]
    },
    "Warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"$ref": "#/$defs/Identifier"},
        "message": {"type": "string", "minLength": 1},
        "severity": {"type": "string", "enum": ["info", "warning", "error"]},
        "path": {"type": ["string", "null"]},
        "details": {"type": "object", "additionalProperties": true}
      }
    },
    "SourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"$ref": "#/$defs/Identifier"},
        "description": {"type": ["string", "null"]},
        "uri": {"type": ["string", "null"], "format": "uri-reference"},
        "version": {"type": ["string", "null"]},
        "license": {"type": ["string", "null"]},
        "retrieved_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "VersionReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"$ref": "#/$defs/Identifier"},
        "version": {"type": "string", "minLength": 1},
        "content_hash": {"$ref": "#/$defs/ContentHash"}
      }
    },
    "DatasetReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"$ref": "#/$defs/Identifier"},
        "version": {"type": "string", "minLength": 1},
        "checksum": {"type": ["string", "null"]},
        "license": {"type": ["string", "null"]},
        "source_uri": {"type": ["string", "null"], "format": "uri-reference"}
      }
    },
    "EngineReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"$ref": "#/$defs/Identifier"},
        "version": {"type": "string", "minLength": 1},
        "content_hash": {"type": ["string", "null"]}
      }
    },
    "TimeWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "string", "format": "date-time"},
        "exact": {
          "type": "array",
          "items": {"type": "string", "format": "date-time"},
          "uniqueItems": true
        },
        "end": {"type": "string", "format": "date-time"},
        "timezone_id": {"type": ["string", "null"]}
      }
    },
    "ScoreSet": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "activity": {"type": "number", "minimum": 0, "maximum": 1},
        "support": {"type": "number", "minimum": 0, "maximum": 1},
        "pressure": {"type": "number", "minimum": 0, "maximum": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "PageInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["has_more"],
      "properties": {
        "next_cursor": {"type": ["string", "null"]},
        "has_more": {"type": "boolean"}
      }
    }
  }
}
