{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interstellar.dev/schemas/v1/time-spec.schema.json",
  "title": "TimeSpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["calendar", "local_value", "precision", "utc_candidates", "confidence", "source", "warnings"],
  "properties": {
    "calendar": {"type": "string", "enum": ["gregorian", "julian", "proleptic_gregorian", "custom"]},
    "local_value": {
      "oneOf": [
        {"type": "string", "format": "date"},
        {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?!.*(?:Z|[+-][0-9]{2}:[0-9]{2})$).+$"}
      ]
    },
    "precision": {"type": "string", "enum": ["second", "minute", "quarter_hour", "hour", "part_of_day", "date", "interval", "unknown"]},
    "timezone_id": {"type": ["string", "null"], "minLength": 1},
    "utc_candidates": {
      "type": "array",
      "items": {"type": "string", "format": "date-time"},
      "uniqueItems": true,
      "maxItems": 2
    },
    "selected_utc": {"type": ["string", "null"], "format": "date-time"},
    "confidence": {"type": "string", "enum": ["high", "medium", "low", "disputed", "unknown"]},
    "source": {"$ref": "common.schema.json#/$defs/SourceReference"},
    "timezone_dataset": {"$ref": "common.schema.json#/$defs/DatasetReference"},
    "historical_confidence": {"type": ["string", "null"], "enum": ["high", "medium", "low", "unknown", null]},
    "manual_override": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["original_value", "replacement_value", "reason", "actor_id", "changed_at"],
      "properties": {
        "original_value": {"type": "string"},
        "replacement_value": {"type": "string"},
        "reason": {"type": "string", "minLength": 1},
        "actor_id": {"$ref": "common.schema.json#/$defs/Identifier"},
        "changed_at": {"type": "string", "format": "date-time"}
      }
    },
    "uncertainty_seconds": {"type": ["integer", "null"], "minimum": 0},
    "warnings": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/Warning"}}
  },
  "allOf": [
    {
      "if": {"properties": {"precision": {"enum": ["date", "unknown"]}}, "required": ["precision"]},
      "then": {
        "properties": {
          "local_value": {"type": "string", "format": "date"},
          "selected_utc": {"type": "null"},
          "utc_candidates": {"maxItems": 0}
        }
      }
    },
    {
      "if": {"properties": {"selected_utc": {"type": "string"}}, "required": ["selected_utc"]},
      "then": {"properties": {"utc_candidates": {"minItems": 1}}}
    }
  ]
}
