# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
.playwright-cli/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# python
**/__pycache__/
*.py[cod]
.venv/
apps/**/.venv/

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem
nul
.temp/

# Xcode / SwiftPM local state
**/.build/
**/xcuserdata/
*.xcuserstate
DerivedData/

# Proprietary interpretation content injected into official iOS builds.
# Only schemas, loaders, and non-proprietary test fixtures belong in Git.
/ios/PrivateContent/
/ios/App/Resources/PrivateContent*.json
/ios/App/Resources/PrivateCorpus*.json
/ios/App/Resources/CopyCatalog*.json
/ios/TranslationExports/
/ios/PrivateRules/
/ios/App/Resources/PrivateRules*.json
/ios/Artifacts/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
Interstellar-Relay-管理员凭据.txt

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
apps/**/dist/
/.wrangler/
/outputs/
/output/
/var/
/work/

# Local Obsidian vault. It contains proprietary corpus and must never gain new
# tracked files in the application repository, even while GitHub is private.
# Some legacy files are already tracked and require a separate index migration.
/obsidian/interstellar/

# JPL validation kernels exceed ordinary Git hosting file limits. The exact
# official URL, size and SHA-256 remain locked in data-manifests; bootstrap with
# scripts/fetch_jpl_validation_kernels.py after cloning.
/vendor/jpl-naif/kernels/spk/*.bsp

# Codex execution progress (local only)
/ios-v2-progress.md
/relay/relay
/relay/relay.exe
