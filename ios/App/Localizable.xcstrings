    "insight.transit.activity-reflects-transiting-houses-activated-natal-planets-and-overlapp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Activity reflects transiting houses, activated natal planets and overlapping exact contacts. It is not a fortune or success score."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "活动度反映行运行星落宫、被触发的本命星体与重叠的精确接触；它不是运气或成功评分。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La actividad refleja las casas transitadas, los planetas natales activados y los contactos exactos superpuestos. No es una puntuación de fortuna ni de éxito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’activité reflète les maisons transitées, les planètes natales activées et les contacts exacts qui se chevauchent. Ce n’est pas un score de chance ou de réussite."
          }
        }
      }
    },
