    "insight.synastry.this-overview-separates-relationship-functions-because-the-same-connecti" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This overview separates relationship functions because the same connection can flow easily in one area and require adjustment in another."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este resumen separa las funciones de la relación porque una misma conexión puede fluir con facilidad en un área y requerir ajustes en otra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette vue d’ensemble distingue les fonctions de la relation, car un même lien peut être fluide dans un domaine et demander des ajustements dans un autre."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这张总览会分别呈现不同关系功能，因为同一段连接可能在一个领域自然顺畅，在另一个领域需要磨合。"
          }
        }
      }
    },
