        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trayectorias planetarias muestra la ubicación y el movimiento. Tránsitos activos muestra las relaciones exactas con planetas y puntos natales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trajectoires planétaires montre la position et le mouvement. Transits actifs montre les relations exactes avec les planètes et points natals."
