    "ai.network-consent.chart-message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you tap Generate, the calculated chart facts needed for the report are sent securely. The report stays on this device. One Credit is charged only after the report is verified and saved. You can turn off future online generation at any time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al pulsar Generar, se envían de forma segura los datos calculados necesarios. El informe permanece en este dispositivo. Solo se cobra 1 Credit después de validarlo y guardarlo. Puedes desactivar futuras generaciones en línea cuando quieras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque vous touchez Générer, les faits calculés nécessaires sont envoyés de façon sécurisée. Le rapport reste sur cet appareil. Un seul Credit est débité après validation et enregistrement. Vous pouvez désactiver les futures générations en ligne à tout moment."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击生成后，报告所需的星盘计算事实会被安全发送。报告只保存在这台设备上，并且仅在验证通过并成功保存后扣除 1 Credit。你可以随时关闭后续联网生成。"
          }
        }
      }
    },
