      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Timing, orb, house and motion are calculated for the selected chart moment and time zone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时间、容许度、宫位和运动状态均按当前选择的星盘时刻与时区计算。"
          }
        },
