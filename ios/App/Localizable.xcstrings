    "insight.transit.this-module-shows-each-transiting-planets-sign-natal-house-direction-and": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This module shows each transiting planet's sign, natal house, direction and next calculated ingress or station."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里显示每颗行运行星的星座、本命宫位、运动方向，以及下一次已计算的换座、换宫或转向。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este módulo muestra el signo, la casa natal, la dirección y el próximo ingreso o estacionamiento calculado de cada planeta en tránsito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce module affiche, pour chaque planète en transit, son signe, sa maison natale, sa direction et sa prochaine entrée ou station calculée."
          }
        }
      }
    },
    "insight.transit.this-separates-planetary-location-from-aspect-interpretation": {
