      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Synastry compares how {{value1}} and {{value2}} affect each other through inter-aspects and house overlays."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合盘通过跨盘相位与双向落宫，比较 {{value1}} 和 {{value2}} 如何彼此影响。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sinastría compara cómo {{value1}} y {{value2}} se influyen mutuamente mediante aspectos entre cartas y superposiciones de casas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synastrie compare la manière dont {{value1}} et {{value2}} s’influencent à travers les aspects croisés et les superpositions de maisons."
          }
        }
      }
    },
