    "insight.synastry.venus-and-mars-contacts-describe-attraction-and-pursuit-other-major-cont": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Venus and Mars contacts describe attraction and pursuit; other major contacts can add intensity."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "金星与火星联系描述吸引和追求，其他重要联系会增加强度。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los contactos de Venus y Marte describen la atracción y la iniciativa; otros contactos importantes pueden añadir intensidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les contacts de Vénus et Mars décrivent l’attraction et l’élan ; d’autres contacts majeurs peuvent ajouter de l’intensité."
          }
        }
      }
    },
