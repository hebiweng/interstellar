    "profile.feedback-uses-the-network-and-includes-the-app-version-and-device-model": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Feedback uses the network and includes the app version and device model, but never chart or birth data. AI interpretation uses the network only after separate consent in Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "反馈会联网并附带应用版本和设备型号，但不会附带星盘或出生资料。AI 解读只有在你另行授权后才会联网。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los comentarios usan la red e incluyen la versión de la app y el modelo del dispositivo, pero nunca datos de cartas ni de nacimiento. La interpretación con IA usa la red solo tras un consentimiento independiente en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les retours utilisent le réseau et incluent la version de l’app et le modèle de l’appareil, mais jamais les données de carte ou de naissance. L’interprétation par IA utilise le réseau uniquement après un consentement séparé dans Réglages."
          }
        }
      }
    },
    "profile.generated-interpretations-will-be-regenerated-next-time-you-open-them": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Generated interpretations will be regenerated next time you open them."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下次打开时，生成内容会重新请求。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las interpretaciones generadas se volverán a generar la próxima vez que las abras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les interprétations générées seront régénérées lors de leur prochaine ouverture."
          }
        }
      }
    },
