    "reports.richer-calculated-details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A report works with richer calculated details for the selected chart—including planet positions, houses and angles, aspects, orbs and strength, motion and timing, plus Modern or Classical assessments where available."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El informe utiliza más detalles calculados de la carta elegida: posiciones planetarias, casas y ángulos, aspectos, orbes e intensidad, movimiento y tiempos, además de evaluaciones modernas o clásicas cuando estén disponibles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le rapport s’appuie sur davantage de détails calculés pour le thème choisi : positions planétaires, maisons et angles, aspects, orbes et intensité, mouvements et temporalité, ainsi que les évaluations modernes ou classiques disponibles."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "报告会根据所选盘型结合更丰富的计算细节，包括星体位置、宫位与四轴、相位及其容许度和强度、运行状态与时间信息，以及适用的现代或古典评估。"
          }
        }
      }
    },
