        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可能性和适合度表示当前盘面模型中的支持程度，并非统计学概率。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La probabilidad y la idoneidad describen el grado de apoyo dentro de este modelo de carta. No son probabilidades estadísticas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La probabilité et l’adéquation décrivent le degré de soutien dans ce modèle de carte. Ce ne sont pas des probabilités statistiques."
          }
        }
      }
    },
