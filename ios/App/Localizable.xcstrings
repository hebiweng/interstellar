    "insight.transit.a-planet-can-matter-because-of-the-house-it-occupies-even-when-no-exact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A planet can matter because of the house it occupies even when no exact natal aspect is active."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使没有正在生效的精确本命相位，行星也会因所处宫位而具有明确的领域重点。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un planeta puede ser importante por la casa que ocupa incluso cuando no hay ningún aspecto natal exacto activo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une planète peut compter en raison de la maison qu’elle occupe, même lorsqu’aucun aspect natal exact n’est actif."
          }
        }
      }
    },
