# Copy this file to .env and replace every `change-me-*` value before startup.
# Never commit .env. Generate secrets, for example, with:
#   openssl rand -hex 32

COMPOSE_PROJECT_NAME=interstellar

# Host-run FastAPI service. Container deployments override the host to 0.0.0.0.
INTERSTELLAR_API_HOST=127.0.0.1
INTERSTELLAR_API_PORT=8018
# Browser-facing URL is embedded into the frontend bundle at build time.
NEXT_PUBLIC_INTERSTELLAR_API_URL=http://127.0.0.1:8018/api/v1
INTERSTELLAR_SWISS_EPHEMERIS_PATH=vendor/swisseph/ephe
# Explicit comma-separated origins only. Wildcards are rejected.
INTERSTELLAR_CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# PostgreSQL / PostGIS
INTERSTELLAR_POSTGRES_DB=interstellar
INTERSTELLAR_POSTGRES_USER=interstellar_owner
INTERSTELLAR_POSTGRES_PASSWORD=change-me-postgres-with-a-long-random-secret
INTERSTELLAR_POSTGRES_PORT=5432
# INTERSTELLAR_POSTGIS_IMAGE=postgis/postgis:16-3.4-alpine

# Redis. The default Redis user is disabled; the application uses this ACL user.
INTERSTELLAR_REDIS_USERNAME=interstellar_app
INTERSTELLAR_REDIS_PASSWORD=change-me-redis-with-a-long-random-secret
INTERSTELLAR_REDIS_PORT=6379
# INTERSTELLAR_REDIS_IMAGE=redis:7.4-alpine

# MinIO administrative credentials are only used by MinIO and minio-init.
# Application code must use the separate app access key and secret below.
INTERSTELLAR_MINIO_ROOT_USER=change-me-storage-admin
INTERSTELLAR_MINIO_ROOT_PASSWORD=change-me-minio-root-with-a-long-random-secret
INTERSTELLAR_MINIO_APP_ACCESS_KEY=change-me-interstellar-app-key
INTERSTELLAR_MINIO_APP_SECRET_KEY=change-me-minio-app-with-a-long-random-secret
INTERSTELLAR_MINIO_ARTIFACTS_BUCKET=interstellar-artifacts
INTERSTELLAR_MINIO_IMPORTS_BUCKET=interstellar-imports
INTERSTELLAR_MINIO_EXPORTS_BUCKET=interstellar-exports
INTERSTELLAR_MINIO_API_PORT=9000
INTERSTELLAR_MINIO_CONSOLE_PORT=9001
# INTERSTELLAR_MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-04-22T22-12-26Z
# INTERSTELLAR_MINIO_MC_IMAGE=quay.io/minio/mc:RELEASE.2025-04-16T18-13-26Z

# Mailpit is a local-only email sink. SMTP authentication is intentionally
# permissive because its ports are bound to 127.0.0.1 and it must never be used
# outside development.
INTERSTELLAR_MAILPIT_SMTP_PORT=1025
INTERSTELLAR_MAILPIT_UI_PORT=8025
INTERSTELLAR_MAILPIT_MAX_MESSAGES=5000
# INTERSTELLAR_MAILPIT_IMAGE=axllent/mailpit:v1.20.4

# Canonical local connection settings for future application services.
# Keep these in sync with the values above. External providers can replace
# these URLs without requiring application code changes.
INTERSTELLAR_DATABASE_URL=postgresql://interstellar_owner:change-me-postgres-with-a-long-random-secret@postgres:5432/interstellar
INTERSTELLAR_REDIS_URL=redis://interstellar_app:change-me-redis-with-a-long-random-secret@redis:6379/0
INTERSTELLAR_S3_ENDPOINT=http://minio:9000
INTERSTELLAR_S3_REGION=us-east-1
INTERSTELLAR_S3_ACCESS_KEY=change-me-interstellar-app-key
INTERSTELLAR_S3_SECRET_KEY=change-me-minio-app-with-a-long-random-secret
INTERSTELLAR_S3_FORCE_PATH_STYLE=true
INTERSTELLAR_SMTP_URL=smtp://mailpit:1025
