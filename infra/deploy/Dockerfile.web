FROM node:22-bookworm-slim AS build

ENV NODE_OPTIONS=--max-old-space-size=768
WORKDIR /opt/interstellar
COPY package.json package-lock.json ./
RUN npm ci --registry=https://registry.npmmirror.com

COPY app ./app
COPY public ./public
COPY .openai ./.openai
COPY build ./build
COPY drizzle ./drizzle
COPY worker ./worker
COPY next.config.ts postcss.config.mjs tsconfig.json vite.config.ts ./
ARG NEXT_PUBLIC_INTERSTELLAR_API_URL=http://127.0.0.1:8018/api/v1
ENV NEXT_PUBLIC_INTERSTELLAR_API_URL=$NEXT_PUBLIC_INTERSTELLAR_API_URL
RUN npm run build

FROM node:22-bookworm-slim AS runtime

ENV NODE_ENV=production \
    PORT=3000 \
    NODE_OPTIONS=--max-old-space-size=256 \
    NEXT_PUBLIC_INTERSTELLAR_API_URL=${NEXT_PUBLIC_INTERSTELLAR_API_URL:-http://127.0.0.1:8018/api/v1}
WORKDIR /opt/interstellar

RUN groupadd --system --gid 10001 interstellar \
    && useradd --system --uid 10001 --gid interstellar --home /opt/interstellar interstellar

COPY --from=build --chown=interstellar:interstellar /opt/interstellar/dist/standalone ./

USER interstellar
EXPOSE 3000
CMD ["node", "server.js"]
