# Copy to /opt/interstellar/.env on the server. Never commit the real file.
INTERSTELLAR_IMAGE_TAG=latest
INTERSTELLAR_BUILD_COMMIT=unknown
INTERSTELLAR_DATA_DIR=/opt/interstellar/data

# Optional. Leave blank until a fresh key has been created and installed only
# on the server. Never put this value in a NEXT_PUBLIC_* variable.
INTERSTELLAR_DEEPSEEK_API_KEY=
INTERSTELLAR_DEEPSEEK_BASE_URL=https://api.deepseek.com
INTERSTELLAR_DEEPSEEK_MODEL=deepseek-v4-pro
