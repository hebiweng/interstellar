# Copy to /opt/interstellar/.env on the server. Never commit the real file.
INTERSTELLAR_IMAGE_TAG=latest
INTERSTELLAR_BUILD_COMMIT=unknown
INTERSTELLAR_DATA_DIR=/opt/interstellar/data

# Bootstrap the first super administrator. Use a unique server-only password.
INTERSTELLAR_ADMIN_BOOTSTRAP_EMAIL=
INTERSTELLAR_ADMIN_BOOTSTRAP_PASSWORD=
# 32+ random characters; encrypts provider API keys stored by the admin console.
INTERSTELLAR_ADMIN_MASTER_KEY=

# The bundled production profile uses a small in-memory timezone fallback.
# Do not set path/version here unless mounting the full Timezone Boundary
# Builder archive on a host with at least 4 GiB RAM.
# INTERSTELLAR_TIMEZONE_BOUNDARIES_PATH=/opt/interstellar/vendor/timezone-boundary-builder/timezones-2026b.geojson.zip
# INTERSTELLAR_TIMEZONE_BOUNDARIES_DATASET_VERSION=2026b-full

# Optional. Leave blank until a fresh key has been created and installed only
# on the server. Never put this value in a NEXT_PUBLIC_* variable.
INTERSTELLAR_DEEPSEEK_API_KEY=
INTERSTELLAR_DEEPSEEK_BASE_URL=https://api.deepseek.com
INTERSTELLAR_DEEPSEEK_MODEL=deepseek-v4-flash

# iOS AI Relay. Generate all three values on the deployment machine and keep
# the resulting .env readable only by root. The admin password must contain at
# least 24 bytes; production deployment uses 32 random bytes.
RELAY_SECRET=
RELAY_ADMIN_USER=
RELAY_ADMIN_PASS=
RELAY_DAILY_GENERATION_QUOTA=20
