fate.xiaoguiwk.top {
  encode zstd gzip

  @api path /api/v1/* /health/live /health/ready
  handle @api {
    reverse_proxy interstellar-api:8018
  }

  @relay path /relay/*
  handle @relay {
    uri strip_prefix /relay
    reverse_proxy interstellar-relay:8080
  }

  @relayadmin path /xiaoguiwk-api/*
  handle @relayadmin {
    uri strip_prefix /xiaoguiwk-api
    reverse_proxy interstellar-relay:8080
  }

  @relayadminui path /xiaoguiwk /xiaoguiwk/*
  handle @relayadminui {
    reverse_proxy interstellar-relay:8080
  }

  handle {
    reverse_proxy interstellar-web:3000
  }

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Referrer-Policy "strict-origin-when-cross-origin"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
  }
}

aaadmin.xiaoguiwk.top {
  encode zstd gzip
  reverse_proxy interstellar-relay:8080

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Referrer-Policy "no-referrer"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
  }
}
